#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Build the pockterm.com landing pages in every language the app ships.

  scripts/build-site [--out DIR]

The English page (site/index.html) is the template; site/content.json holds the
translated copy, keyed by the index of each text node in that template. Both
live in the repo on purpose: the first generator lived only in a session
scratchpad and was lost, after which the deployed S3 objects were the sole copy.

The <head> is not text nodes, so its copy is kept separately under "head" in
content.json, as plain text (it is escaped here): the <title> and meta
description, which og:title and og:description repeat. canonical and og:url
are each page's own URL, not the home page's, or search engines fold every
language into the English page.

The language list, its order and the page names come from scripts/site_langs.py,
shared with build-manual and build-privacy.

Flat files (es.html rather than es/index.html) because CloudFront applies its
default root object only at the root, so a directory URL 404s against an S3
origin behind OAC — the same reason scripts/build-manual emits flat files.

Deploy is deliberately NOT automated here. Publishing a language page tells
visitors the app speaks their language; do not put one up before the release
that ships it. Upload with:

  aws s3 cp <file> s3://pockterm-site-071350569379/ \\
      --content-type "text/html; charset=utf-8" --cache-control "public, max-age=300"
  aws cloudfront create-invalidation --distribution-id EZUC486Q5M7TE --paths "/*"
"""
import argparse
import json
import pathlib
import re
import sys

from site_langs import ORDER, SITE, alternates, home, html_attrs, langbar, manual, privacy

ROOT = pathlib.Path(__file__).resolve().parent.parent
TEMPLATE = ROOT / "site/index.html"
CONTENT = ROOT / "site/content.json"
# Every shipped language now has its own demo cut (scripts/build-demo-videos),
# so no page falls back to the English one.
HAS_VIDEO = set(ORDER)

NODE = re.compile(r">([^<>]{1,300})<")
UNSPACED = {"ja", "zh-Hans", "zh-Hant"}


def page_name(code):
    return "index.html" if code == "en" else f"{code}.html"


def video(code):
    return "/pockterm-demo.mp4" if code not in HAS_VIDEO or code == "en" \
        else f"/pockterm-demo-{code}.mp4"


def attr(text):
    """Plain text -> safe inside a double-quoted attribute or <title>."""
    return (text.replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def sub_once(pattern, replacement, text):
    """Replace exactly one match, so a changed template fails loudly."""
    new, n = re.subn(pattern, lambda _: replacement, text, count=1, flags=re.S)
    if n != 1:
        sys.exit(f"template has no match for {pattern!r}")
    return new


def build(code, template, data):
    body_at = template.index("<body")
    head, body = template[:body_at], template[body_at:]
    varying = {int(i) for i in data["varying"]}
    strings = data["strings"][code]

    # Substitute the copy, node by node, in template order.
    idx = -1
    def repl(m):
        nonlocal idx
        if not m.group(1).strip():
            return m.group(0)
        idx += 1
        if idx in varying and str(idx) in strings:
            # The copy is stored trimmed, so put back the template's spacing
            # or "<b>Free.</b> No account" renders as "Free.No account" and
            # the code words in the why-paragraph run together. Chinese and
            # Japanese don't space between words, so they stay trimmed.
            text = m.group(1)
            lead = text[:len(text) - len(text.lstrip())]
            trail = text[len(text.rstrip()):]
            if code in UNSPACED:
                lead = trail = ""
            if strings[str(idx)].endswith("-"):
                trail = ""  # Hebrew's ו- prefix joins the word after it
            return ">" + lead + strings[str(idx)] + trail + "<"
        return m.group(0)
    body = NODE.sub(repl, body)

    # Replace the whole switcher rather than its nodes: the number of
    # languages differs from the template's, and its aria-label is copy too.
    body = sub_once(r'<nav class="langbar".*?</nav>',
                    langbar(code, data["switch_label"][code], home), body)

    # The head: copy, then this page's own URL, then the hreflang alternates
    # (or search engines keep being told only the original six pages exist).
    copy = data["head"][code]
    title, description = attr(copy["title"]), attr(copy["description"])
    url = SITE + home(code)
    head = sub_once(r"<title>.*?</title>", f"<title>{title}</title>", head)
    head = sub_once(r'<meta name="description" content="[^"]*">',
                    f'<meta name="description" content="{description}">', head)
    head = sub_once(r'<meta property="og:title" content="[^"]*">',
                    f'<meta property="og:title" content="{title}">', head)
    head = sub_once(r'<meta property="og:description" content="[^"]*">',
                    f'<meta property="og:description" content="{description}">', head)
    head = sub_once(r'<link rel="canonical" href="[^"]*">',
                    f'<link rel="canonical" href="{url}">', head)
    head = sub_once(r'<meta property="og:url" content="[^"]*">',
                    f'<meta property="og:url" content="{url}">', head)
    head = sub_once(r'<link rel="alternate"[^>]*>(\s*<link rel="alternate"[^>]*>)*',
                    "".join(alternates(home)), head)

    page = head + body
    page = page.replace('href="/manual.html"', f'href="{manual(code)}"')
    page = page.replace('href="/privacy.html"', f'href="{privacy(code)}"')
    page = page.replace('href="/pockterm-demo.mp4"', f'href="{video(code)}"')
    page = sub_once(r'<html[^>]*>', f'<html {html_attrs(code)}>', page)
    return page


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default="build/site")
    args = ap.parse_args()
    data = json.loads(CONTENT.read_text())
    missing = [c for c in ORDER
               if c not in data["strings"] or c not in data["head"]]
    if missing:
        sys.exit(f"no copy for: {missing}")
    template = TEMPLATE.read_text()
    out = pathlib.Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    for code in ORDER:
        page = build(code, template, data)
        left = [s for s in ("What it does", "Why it exists.", "Requires iOS 18",
                            "Source code", "A native SSH and SFTP client",
                            'aria-label="Language"')
                if code != "en" and s in page]
        (out / page_name(code)).write_text(page)
        print(f"  {page_name(code):<16} {len(page):>6} bytes"
              f"{'  UNTRANSLATED: ' + ', '.join(left) if left else ''}")
    print(f"\n{len(ORDER)} pages -> {out}")


if __name__ == "__main__":
    main()
