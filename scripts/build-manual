#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Build the pockterm.com user manual from the app's own help content.

  scripts/build-manual [--out DIR] [--deploy]

The manual is not written twice. `HelpContent.swift` already holds the whole
user guide, and `Localizable.xcstrings` already holds it translated into every
shipped language — so this parses the Swift for structure, looks each string up
in the catalog, and emits one page per language. Change the guide in the app and
the site follows; there is no second copy to forget.

Stdlib only, so unlike scripts/appstore-report there is no venv to bootstrap.

Flat files (manual-es.html rather than es/manual.html) for the same reason the
landing pages are flat: CloudFront applies its default root object only at the
root, so a directory URL 404s against an S3 origin behind OAC.
"""
import argparse
import html
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HELP = ROOT / "pockterm/Features/Help/HelpContent.swift"
CATALOG = ROOT / "pockterm/Localizable.xcstrings"

BUCKET = "s3://pockterm-site-071350569379/"
DISTRIBUTION = "E28OSFYVGJMTML"
APP_STORE = "https://apps.apple.com/app/id6789968094"

# (code, endonym, direction) — order the language switcher shows them in,
# matching the landing pages.
LANGS = [
    ("en", "English", "ltr"),
    ("es", "Español", "ltr"),
    ("ar", "العربية", "rtl"),
    ("he", "עברית", "rtl"),
    ("zh-Hans", "简体中文", "ltr"),
    ("zh-Hant", "繁體中文", "ltr"),
