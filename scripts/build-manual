# --- reading the app -------------------------------------------------------

def unescape(s):
    """Decode the Swift string escapes HelpContent actually uses."""
    s = re.sub(r"\\u\{([0-9A-Fa-f]+)\}", lambda m: chr(int(m.group(1), 16)), s)
    return s.replace('\\"', '"').replace("\\n", "\n").replace("\\\\", "\\")


LITERAL = re.compile(r'"((?:[^"\\]|\\.)*)"')


def literals(text):
    return [unescape(m.group(1)) for m in LITERAL.finditer(text)]


def balanced(text, start):
    """Return the contents of the bracket opening at `start`, skipping strings."""
    depth, i, in_string = 0, start, False
    while i < len(text):
        c = text[i]
        if in_string:
            if c == "\\":
                i += 2
                continue
            if c == '"':
                in_string = False
        elif c == '"':
            in_string = True
        elif c in "([":
            depth += 1
        elif c in ")]":
            depth -= 1
            if depth == 0:
                return text[start + 1:i]
        i += 1
    raise ValueError("unbalanced bracket in HelpContent.swift")


def parse_help():
    """-> [(section_title, [topic, ...])] where topic is a dict."""
    src = HELP.read_text(encoding="utf-8")

    topics = {}
    for m in re.finditer(r"static let (\w+) = HelpTopic\(", src):
        name = m.group(1)
        body = balanced(src, m.end() - 1)
        topic = {"title": None, "summary": None, "blocks": []}
        for field in ("title", "summary"):
            f = re.search(field + r':\s*"((?:[^"\\]|\\.)*)"', body)
            if f:
                topic[field] = unescape(f.group(1))
        for b in re.finditer(r"\.(paragraph|heading|bullets)\s*\(", body):
            kind = b.group(1)
            inner = balanced(body, b.end() - 1)
            items = literals(inner)
            topic["blocks"].append((kind, items))
        topics[name] = topic

    sections = []
    for m in re.finditer(r'HelpSection\(title:\s*"((?:[^"\\]|\\.)*)",\s*topics:\s*\[([^\]]*)\]\)', src):
        names = [n.strip() for n in m.group(2).split(",") if n.strip()]
        sections.append((unescape(m.group(1)), [topics[n] for n in names]))
    if not sections:
        sys.exit("parsed no sections out of HelpContent.swift — did its shape change?")
    return sections


def load_catalog():
    return json.loads(CATALOG.read_text(encoding="utf-8"))["strings"]


# --- rendering -------------------------------------------------------------

INLINE_CODE = re.compile(r"`([^`]+)`")
BOLD = re.compile(r"\*\*(.+?)\*\*")


def markup(text):
    """The guide's light markdown -> HTML, escaped first.

    Code spans are isolated: a path or a shell command is left-to-right content
    even inside an Arabic or Hebrew page, the same rule the app applies.
    """
    out = html.escape(text, quote=False)
    out = INLINE_CODE.sub(lambda m: f'<code dir="ltr">{m.group(1)}</code>', out)
    out = BOLD.sub(lambda m: f"<strong>{m.group(1)}</strong>", out)
    return out


def slug(text, used):
    base = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "topic"
    candidate, n = base, 2
    while candidate in used:
        candidate, n = f"{base}-{n}", n + 1
    used.add(candidate)
    return candidate


