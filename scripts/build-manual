MARK_SVG = """<svg viewBox="0 0 32 32" aria-hidden="true">
        <path d="M8 11l4.5 4.5L8 20" stroke="#40d17f" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M16.5 21h7" stroke="#40d17f" stroke-width="2.5" stroke-linecap="round"/>
      </svg>"""

FAVICON = ("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'>"
           "<rect width='32' height='32' rx='7' fill='%230b1220'/>"
           "<path d='M8 11l4.5 4.5L8 20' stroke='%2340d17f' stroke-width='2.5' fill='none' "
           "stroke-linecap='round' stroke-linejoin='round'/>"
           "<path d='M16.5 21h7' stroke='%2340d17f' stroke-width='2.5' stroke-linecap='round'/></svg>")


def langbar(current, label):
    items = []
    for code, name, _ in LANGS:
        if code == current:
            items.append(f'<span aria-current="true" lang="{code}">{name}</span>')
        else:
            items.append(f'<a href="/{page(code)}" lang="{code}" hreflang="{code}">{name}</a>')
    return (f'<nav class="langbar" aria-label="{label}">'
            f'<span class="lb-label">{label}</span>' + "".join(items) + "</nav>")


def build(code, direction, sections, catalog, missing):
    c = CHROME[code]

    def tr(key):
        if code == "en":
            return key
        entry = catalog.get(key, {}).get("localizations", {}).get(code, {})
        value = entry.get("stringUnit", {}).get("value")
        if not value:
            missing.append((code, key))
            return key
        return value

    used = set()
    body, toc = [], []
    for section_title, topics in sections:
        section = tr(section_title)
        body.append(f"  <h2>{html.escape(section)}</h2>")
        for topic in topics:
            title = tr(topic["title"])
            anchor = slug(topic["title"], used)
            toc.append(f'<li><a href="#{anchor}">{html.escape(title)}</a></li>')
            body.append(f'  <article id="{anchor}">')
            body.append(f"    <h3>{html.escape(title)}</h3>")
            if topic["summary"]:
                body.append(f'    <p class="summary">{html.escape(tr(topic["summary"]))}</p>')
            for kind, items in topic["blocks"]:
                if kind == "paragraph":
                    body.append(f"    <p>{markup(tr(items[0]))}</p>")
                elif kind == "heading":
                    body.append(f"    <h4>{html.escape(tr(items[0]))}</h4>")
                else:
                    body.append("    <ul>")
                    for item in items:
                        body.append(f"      <li>{markup(tr(item))}</li>")
                    body.append("    </ul>")
            body.append("  </article>")

    alternates = "\n".join(
        f'<link rel="alternate" hreflang="{c2}" href="https://pockterm.com/{page(c2)}">'
        for c2, _, _ in LANGS)
    arrow = "&rarr;" if direction == "rtl" else "&larr;"
    title = f"{c['guide']} — Pockterm"
    dir_attr = ' dir="rtl"' if direction == "rtl" else ""

    return f"""<!doctype html>
<html lang="{code}"{dir_attr}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content="{html.escape(c['sub'], quote=True)}">
<link rel="canonical" href="https://pockterm.com/{page(code)}">
{alternates}
<link rel="alternate" hreflang="x-default" href="https://pockterm.com/manual.html">
<meta property="og:title" content="{title}">
<meta property="og:description" content="{html.escape(c['sub'], quote=True)}">
<meta property="og:url" content="https://pockterm.com/{page(code)}">
<meta property="og:type" content="article">
<meta name="twitter:card" content="summary">
<link rel="icon" href="{FAVICON}">
<style>{CSS}</style>
</head>
<body>
<div class="wrap">

  <a class="home" href="{home(code)}">{arrow} Pockterm</a>

  <header>
    <div class="mark">
      {MARK_SVG}
    </div>
    <h1>{c['guide']}</h1>
    <p class="tag">{c['sub']}</p>
  </header>

  {langbar(code, c['lang'])}

  <nav class="toc" aria-label="{c['contents']}">
    <h2>{c['contents']}</h2>
    <ol>{''.join(toc)}</ol>
  </nav>

{chr(10).join(body)}

  <footer>
    <a href="{home(code)}">Pockterm</a>
    <a href="/privacy.html">{c['privacy']}</a>
    <a href="{APP_STORE}">App&nbsp;Store</a>
    <a href="mailto:jhancock1975@gmail.com">{c['contact']}</a>
    <p style="margin:1.2rem 0 0;">{c['foot']}</p>
  </footer>

</div>
</body>
</html>
"""


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", type=Path, help="output directory (default: a temp dir)")
    ap.add_argument("--deploy", action="store_true", help="upload to S3 and invalidate CloudFront")
    args = ap.parse_args()

    out = args.out or Path(tempfile.mkdtemp(prefix="pockterm-manual-"))
    out.mkdir(parents=True, exist_ok=True)

    sections = parse_help()
    catalog = load_catalog()
    topics = sum(len(t) for _, t in sections)
    print(f"{len(sections)} sections, {topics} topics from HelpContent.swift")

    missing = []
    written = []
    for code, _, direction in LANGS:
        html_text = build(code, direction, sections, catalog, missing)
        path = out / page(code)
        path.write_text(html_text, encoding="utf-8")
        written.append(path)
        print(f"  {page(code):20} {len(html_text):6} bytes  dir={direction}")

    if missing:
        print(f"\n{len(missing)} untranslated strings (fell back to English):")
        for code, key in missing[:20]:
            print(f"  {code:8} {key[:70]}")
    else:
        print("\nevery string translated in all languages")

    print(f"\noutput: {out}")

    if args.deploy:
        for path in written:
            subprocess.run(["aws", "s3", "cp", str(path), BUCKET,
                            "--content-type", "text/html; charset=utf-8",
                            "--cache-control", "public, max-age=300"], check=True)
        subprocess.run(["aws", "cloudfront", "create-invalidation",
                        "--distribution-id", DISTRIBUTION, "--paths", "/*"], check=True)
        print("deployed and invalidated")


if __name__ == "__main__":
    main()
