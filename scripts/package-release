#!/bin/bash
# Archive and export a signed Pockterm build for App Store submission.
#
#   scripts/package-release            # archive + export App Store ipa
#   scripts/package-release --archive  # archive only
#
# Two defences against leaking build paths into the shipped binary. Clang bakes
# __FILE__ strings from C dependencies (swift-crypto's BoringSSL) into the
# binary, so a default archive embeds ~180 copies of
# /Users/<you>/Library/Developer/Xcode/... and hands the account name to anyone
# who runs `strings` on the App Store build.
#
#   1. -ffile-prefix-map rewrites those strings at compile time, so the paths
#      are stripped wherever the build happens. This is the actual fix.
#   2. The neutral derived-data path below is kept as a backstop: if the flag
#      ever stops reaching a dependency, the worst case is a /tmp path rather
#      than a home directory. The identity check further down enforces it.
#
# 1.6 and earlier shipped with 181 /tmp/pockterm-release/... strings — neutral,
# but present. From 1.7 there should be none.
set -euo pipefail

cd "$(dirname "$0")/.."
BUILD_ROOT=/tmp/pockterm-release
DERIVED="$BUILD_ROOT/dd"
ARCHIVE="$BUILD_ROOT/pockterm.xcarchive"
EXPORT_DIR="$BUILD_ROOT/export"
OUT=build/release

rm -rf "$BUILD_ROOT"
mkdir -p "$DERIVED" "$OUT"

echo "==> archiving (neutral derived-data path: $DERIVED)"
# -skipPackagePluginValidation: SwiftTerm 1.19.0+ carries a build-tool plugin;
# see the note in scripts/test.sh.
# Map the checkout root away so __FILE__ reads "swift-crypto/Sources/..." with
# no absolute prefix at all. $(inherited) so targets keep their own flags.
# Xcode 27 hands clang the resolved path, /private/tmp/..., so the /tmp form
# alone matches nothing and 181 paths came back in 1.8. Map both spellings.
CHECKOUTS="$DERIVED/SourcePackages/checkouts/"
PREFIX_MAP="-ffile-prefix-map=$CHECKOUTS= -ffile-prefix-map=/private$CHECKOUTS= -ffile-prefix-map=$PWD/="
xcodebuild -project pockterm.xcodeproj -scheme pockterm \
    -configuration Release -destination 'generic/platform=iOS' \
    -derivedDataPath "$DERIVED" -archivePath "$ARCHIVE" \
    -skipPackagePluginValidation \
    OTHER_CFLAGS="\$(inherited) $PREFIX_MAP" \
    OTHER_CPLUSPLUSFLAGS="\$(inherited) $PREFIX_MAP" \
    -allowProvisioningUpdates archive

BIN="$ARCHIVE/Products/Applications/pockterm.app/pockterm"
echo
echo "==> identity check on the archived binary"
LEAKS=$(strings -a "$BIN" | grep -oE '/Users/[A-Za-z0-9._-]+' | sort -u || true)
if [[ -n "$LEAKS" ]]; then
    echo "!! personal build paths still present:"; echo "$LEAKS"
    echo "   (refusing to export — fix before submitting)"
    exit 1
fi
echo "   ok no personal build paths in the shipped binary"

# Any absolute build path at all means -ffile-prefix-map stopped reaching a
# dependency. Not an identity leak on its own, but it is how one starts.
BUILDPATHS=$(strings -a "$BIN" | grep -cE '(^|[^A-Za-z0-9])/(tmp|Users|home|private)/' || true)
if [[ "$BUILDPATHS" -gt 0 ]]; then
    echo "   !! $BUILDPATHS absolute build path(s) still embedded — prefix map is not reaching everything:"
    strings -a "$BIN" | grep -oE '/(tmp|Users|home|private)/[A-Za-z0-9._/-]{0,40}' | sort -u | head -3
else
    echo "   ok no absolute build paths at all"
fi

if [[ "${1:-}" == "--archive" ]]; then
    cp -R "$ARCHIVE" "$OUT/" && echo && echo "archive: $OUT/$(basename "$ARCHIVE")"
    exit 0
fi

echo
echo "==> exporting for App Store"
cat > "$BUILD_ROOT/ExportOptions.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key><string>app-store-connect</string>
    <key>destination</key><string>export</string>
    <key>teamID</key><string>5H22F8M69N</string>
    <key>uploadSymbols</key><true/>
    <key>signingStyle</key><string>manual</string>
    <key>signingCertificate</key><string>Apple Distribution</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>John-Hancock.pockterm</key><string>Pockterm App Store</string>
    </dict>
</dict>
</plist>
PLIST

# Manual signing on purpose. Automatic signing would have to *mint* a
# distribution profile, which headless means cloud signing via an API key with
# the Admin role — our App Manager key fails with "Cloud signing permission
# error". The "Pockterm App Store" profile already exists, so signing against it
# directly needs no Admin key and no Xcode GUI.
PROFILE_DIR="$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles"
if ! grep -qla "Pockterm App Store" "$PROFILE_DIR"/*.mobileprovision 2>/dev/null; then
    echo "!! the 'Pockterm App Store' provisioning profile is not installed."
    echo "   Fetch and install it with:"
    echo "     scripts/fetch-provisioning-profile"
    exit 1
fi

if ! xcodebuild -exportArchive -archivePath "$ARCHIVE" \
        -exportOptionsPlist "$BUILD_ROOT/ExportOptions.plist" \
        -exportPath "$EXPORT_DIR"; then
    cp -R "$ARCHIVE" "$OUT/" 2>/dev/null || true
    cat >&2 <<'MSG'

Export failed, but the archive is built and identity-checked at
build/release/pockterm.xcarchive. Check that the distribution certificate and
the "Pockterm App Store" profile are both present:

  security find-identity -v -p codesigning | grep Distribution
  scripts/fetch-provisioning-profile

Failing that, open the archive in Xcode: Window > Organizer > Distribute App.
MSG
    exit 1
fi

cp -R "$ARCHIVE" "$OUT/" 2>/dev/null || true
cp "$EXPORT_DIR"/*.ipa "$OUT/" 2>/dev/null || true

echo
echo "artifacts in $OUT:"
ls -la "$OUT" | tail -n +2
echo
echo "Next: upload with"
echo "  xcrun altool --upload-app -f $OUT/pockterm.ipa -t ios \\"
echo "    --apiKey WVYS8ZU585 --apiIssuer \$(grep -oE '[0-9a-f-]{36}' ~/Documents/Apps/pockterm/key-issuer-id.txt)"
echo
echo "Before submitting for review: re-provision the demo SSH host and paste fresh"
echo "credentials into the App Store Connect review notes. App Review will try to"
echo "connect, and 2.1 rejection is the usual result when they cannot."
