    "Ask about what's on screen, or ask for a command.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل عمّا يظهر على الشاشة، أو اطلب أمرًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta sobre lo que ves en pantalla o pide un comando."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאל על מה שמופיע במסך, או בקש פקודה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问屏幕上的内容，或让它给出命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詢問螢幕上的內容，或請它提供指令。"
          }
        }
      }
    },
