    "Tap **+** to create a folder. **Pull down** to refresh the listing.": {},
    "Tap **+**, then **Upload File**.": {},
    "Tap **..** at the top to go up a directory.": {},
    "Tap **Save**.": {},
    "Tap **▶** to start; the status shows when it's active. Tap **⏹** to stop.": {},
    "Tap + to add a host.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط + لإضافة مضيف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para añadir un host."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש + כדי להוסיף מארח."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 + 添加主机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 + 以加入主機。"
          }
        }
      }
    },
    "Tap + to add a tunnel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
