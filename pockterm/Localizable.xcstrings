    "A SOCKS5 proxy listens on the bind port; each connection is tunneled to its requested destination.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع وكيل SOCKS5 على منفذ الربط؛ ويُنفَّق كل اتصال إلى الوجهة المطلوبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proxy SOCKS5 escucha en el puerto de enlace; cada conexión se tuneliza hacia el destino solicitado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרוקסי SOCKS5 מאזין ביציאת הקישור; כל חיבור מנותב אל היעד שביקש."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SOCKS5 代理在绑定端口上监听；每个连接都会被隧道转发到它请求的目标地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SOCKS5 代理會在綁定埠上監聽；每個連線都會透過通道轉送到它要求的目的地。"
          }
        }
      }
    },
    "AI Assistant": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساعد الذكاء الاصطناعي"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistente de IA"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוזר AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助理"
