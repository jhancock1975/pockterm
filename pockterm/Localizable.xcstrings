    "%lldpt": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‎%lld نقطة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldpt"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‎%lld נק׳"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldpt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 磅"
