          }
        }
      }
    },
    "Paste your config text, or tap **Choose File**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق نص الإعداد الخاص بك، أو اضغط **اختيار ملف**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el texto de tu configuración o toca **Elegir archivo**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le texte de votre configuration, ou touchez **Choisir un fichier**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק את טקסט התצורה שלך, או הקש **בחר קובץ**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il testo della tua configurazione, oppure tocca **Scegli file**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴你的配置文本，或轻点**选择文件**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上你的設定文字，或點一下**選擇檔案**。"
          }
        }
      }
    },
