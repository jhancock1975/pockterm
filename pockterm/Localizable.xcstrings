    "Assign a host to a group in the host editor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسنِد مضيفًا إلى مجموعة من محرّر المضيف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna un host a un grupo en el editor de hosts."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שייך מארח לקבוצה בעורך המארחים."
          }
        },
        "zh-Hans": {
