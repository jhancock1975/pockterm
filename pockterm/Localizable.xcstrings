    "Add a host on the Hosts tab first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مضيفًا من علامة التبويب «المضيفون» أولًا."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε πρώτα έναν διακομιστή στην καρτέλα Διακομιστές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade un host en la pestaña Hosts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord un hôte dans l'onglet Hôtes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תחילה הוסף מארח בלשונית המארחים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले होस्ट टैब में एक होस्ट जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima un host nella scheda Host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に「ホスト」タブでホストを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 호스트 탭에서 호스트를 추가하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте хост на вкладке «Хосты»."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందుగా హోస్ట్‌లు ట్యాబ్‌లో ఒక హోస్ట్‌ను జోడించండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу додайте хост на вкладці «Хости»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“主机”标签页中添加主机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在「主機」標籤頁中加入主機。"
          }
        }
      }
    },
    "Add the shown public-key line to the server's `~/.ssh/authorized_keys` file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف سطر المفتاح العام المعروض إلى ملف `~/.ssh/authorized_keys` على الخادم."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε τη γραμμή δημόσιου κλειδιού που εμφανίζεται στο αρχείο `~/.ssh/authorized_keys` του διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la línea de clave pública que se muestra al archivo `~/.ssh/authorized_keys` del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez la ligne de clé publique affichée au fichier `~/.ssh/authorized_keys` du serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף את שורת המפתח הציבורי המוצגת לקובץ `~/.ssh/authorized_keys` בשרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिखाई गई सार्वजनिक-कुंजी पंक्ति को सर्वर की `~/.ssh/authorized_keys` फ़ाइल में जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la riga di chiave pubblica mostrata al file `~/.ssh/authorized_keys` del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示された公開鍵の行を、サーバの `~/.ssh/authorized_keys` ファイルに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 공개 키 줄을 서버의 `~/.ssh/authorized_keys` 파일에 추가하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте показанную строку открытого ключа в файл `~/.ssh/authorized_keys` на сервере."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చూపిన పబ్లిక్-కీ పంక్తిని సర్వర్‌లోని `~/.ssh/authorized_keys` ఫైల్‌కు జోడించండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте показаний рядок відкритого ключа до файлу `~/.ssh/authorized_keys` на сервері."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把显示的公钥这一行添加到服务器的 `~/.ssh/authorized_keys` 文件中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將顯示的公開金鑰那一行加入伺服器的 `~/.ssh/authorized_keys` 檔案。"
          }
        }
      }
    },
