    "Sends a one-token request to verify the key and model.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل طلبًا برمز واحد للتحقق من المفتاح والنموذج."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνει ένα αίτημα ενός token για επαλήθευση του κλειδιού και του μοντέλου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una petición de un solo token para verificar la clave y el modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie une requête d'un seul jeton pour vérifier la clé et le modèle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח בקשה באורך אסימון אחד כדי לאמת את המפתח ואת הדגם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी और मॉडल जाँचने के लिए एक टोकन का अनुरोध भेजता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia una richiesta da un token per verificare la chiave e il modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 トークンのリクエストを送信して、鍵とモデルを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰 하나짜리 요청을 보내 키와 모델을 확인합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет запрос на один токен, чтобы проверить ключ и модель."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కీని, మోడల్‌ను ధృవీకరించడానికి ఒక టోకెన్ అభ్యర్థనను పంపుతుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає запит на один токен, щоб перевірити ключ і модель."
          }
        },
        "zh-Hans": {
