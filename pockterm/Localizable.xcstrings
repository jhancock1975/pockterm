    "Tap + to save a reusable command.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط + لحفظ أمر قابل لإعادة الاستخدام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para guardar un comando reutilizable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + pour enregistrer une commande réutilisable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש + כדי לשמור פקודה לשימוש חוזר."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca + per salvare un comando riutilizzabile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
