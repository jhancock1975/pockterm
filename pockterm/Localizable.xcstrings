    "Passwords and private keys are kept in the **iOS Keychain**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ كلمات السر والمفاتيح الخاصة في **سلسلة مفاتيح iOS**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas y las claves privadas se guardan en el **Llavero de iOS**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיסמאות ומפתחות פרטיים נשמרים ב**מחזיק המפתחות של iOS**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码和私钥保存在 **iOS 钥匙串**中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼與私密金鑰保存在 **iOS 鑰匙圈**中。"
          }
        }
      }
    },
    "Paste API key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لصق مفتاح API"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar la clave API"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
