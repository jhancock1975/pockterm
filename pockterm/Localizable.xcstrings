    "Assign a host to a group in the host editor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسنِد مضيفًا إلى مجموعة من محرّر المضيف."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιστοιχίστε έναν διακομιστή σε μια ομάδα στον επεξεργαστή διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna un host a un grupo en el editor de hosts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affectez un hôte à un groupe dans l'éditeur d'hôte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שייך מארח לקבוצה בעורך המארחים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्ट संपादक में किसी होस्ट को समूह में डालें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna un host a un gruppo nell'editor dell'host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストエディタで、ホストをグループに割り当てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 편집기에서 호스트를 그룹에 지정하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначьте хосту группу в редакторе хоста."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హోస్ట్ ఎడిటర్‌లో ఒక హోస్ట్‌ను గ్రూప్‌కు కేటాయించండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призначте хосту групу в редакторі хоста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主机编辑器中将主机分配到某个群组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在主機編輯器中將主機指定到某個群組。"
          }
        }
      }
    },
