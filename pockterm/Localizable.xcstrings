    "Replace overwrites what is already on the server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستبدل «استبدال» ما هو موجود بالفعل على الخادم."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Αντικατάσταση αντικαθιστά ό,τι υπάρχει ήδη στον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazar sobrescribe lo que ya hay en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer écrase ce qui se trouve déjà sur le serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלפה דורסת את מה שכבר נמצא בשרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिस्थापित करने से सर्वर पर पहले से मौजूद फ़ाइल ओवरराइट हो जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci sovrascrive ciò che è già sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換えると、サーバ上の既存のファイルが上書きされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대치하면 서버에 이미 있는 파일을 덮어씁니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При замене файл на сервере будет перезаписан."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "భర్తీ చేస్తే సర్వర్‌లో ఇప్పటికే ఉన్నది తిరిగి రాయబడుతుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заміна перезапише те, що вже є на сервері."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换会覆盖服务器上已有的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代會覆寫伺服器上已有的內容。"
          }
        }
      }
    },
