    "Password": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة السر"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיסמה"
          }
        },
        "zh-Hans": {
