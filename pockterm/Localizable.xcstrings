    "Tap **+** to create a folder. **Pull down** to refresh the listing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط **+** لإنشاء مجلد. و**اسحب لأسفل** لتحديث القائمة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca **+** para crear una carpeta. **Desliza hacia abajo** para actualizar el listado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez **+** pour créer un dossier. **Tirez vers le bas** pour actualiser la liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש **+** כדי ליצור תיקייה. **משוך מטה** כדי לרענן את הרשימה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca **+** per creare una cartella. **Trascina verso il basso** per aggiornare l'elenco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 **+** 可新建文件夹。**下拉**可刷新列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 **+** 可新增檔案夾。**下拉**可重新整理列表。"
          }
        }
      }
    },
    "Tap **+**, then **Upload File**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط **+**، ثم **رفع ملف**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca **+** y luego **Subir un archivo**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez **+**, puis **Envoyer un fichier**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש **+** ואז **העלה קובץ**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca **+**, poi **Carica file**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 **+**，然后选择**上传文件**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 **+**，然後選擇**上傳檔案**。"
          }
        }
      }
    },
    "Tap **..** at the top to go up a directory.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط **..** في الأعلى للصعود مجلدًا واحدًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca **..** en la parte superior para subir un directorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez **..** en haut pour remonter d'un répertoire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש **..** בחלק העליון כדי לעלות תיקייה אחת."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca **..** in alto per salire di una directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点顶部的 **..** 可返回上一级目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下頂端的 **..** 可回到上一層目錄。"
          }
        }
      }
    },
    "Tap **Save**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط **حفظ**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca **Guardar**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez **Enregistrer**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש **שמור**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca **Salva**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点**存储**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下**儲存**。"
          }
        }
      }
    },
    "Tap **▶** to start; the status shows when it's active. Tap **⏹** to stop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط **▶** للبدء؛ وتُظهر الحالة متى يكون نشطًا. واضغط **⏹** للإيقاف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca **▶** para iniciar; el estado indica cuándo está activa. Toca **⏹** para detenerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez **▶** pour démarrer ; l'état indique quand la redirection est active. Touchez **⏹** pour l'arrêter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש **▶** כדי להתחיל; המצב מראה מתי הוא פעיל. הקש **⏹** כדי לעצור."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca **▶** per avviare; lo stato indica quando è attivo. Tocca **⏹** per fermarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 **▶** 启动；状态会显示它何时处于活动状态。轻点 **⏹** 停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 **▶** 啟動；狀態會顯示它何時處於作用中。點一下 **⏹** 停止。"
          }
        }
      }
    },
    "Tap + to add a host.": {
      "localizations": {
        "ar": {
          "stringUnit": {
