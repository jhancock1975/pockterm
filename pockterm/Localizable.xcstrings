    "Ask about what's on screen, or ask for a command.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل عمّا يظهر على الشاشة، أو اطلب أمرًا."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρωτήστε για ό,τι βλέπετε στην οθόνη ή ζητήστε μια εντολή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta sobre lo que ves en pantalla o pide un comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question sur ce qui est à l'écran, ou demandez une commande."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאל על מה שמופיע במסך, או בקש פקודה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन पर जो है उसके बारे में पूछें, या कोई कमांड माँगें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi informazioni su ciò che vedi sullo schermo, oppure chiedi un comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に表示されている内容について質問したり、コマンドを尋ねたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 있는 내용에 관해 묻거나 명령어를 요청하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите о том, что на экране, или попросите команду."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్క్రీన్‌పై ఉన్నదాని గురించి అడగండి, లేదా ఒక కమాండ్ అడగండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте про те, що на екрані, або попросіть команду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问屏幕上的内容，或让它给出命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詢問螢幕上的內容，或請它提供指令。"
          }
        }
      }
    },
    "Ask the assistant…": {
      "localizations": {
        "ar": {
          "stringUnit": {
