        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 + 以加入通道。"
          }
        }
      }
    },
    "Tap + to generate an Ed25519 key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط + لتوليد مفتاح Ed25519."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
