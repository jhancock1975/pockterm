    },
    "Pockterm creates an Ed25519 key pair and stores the private key in the iOS Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ Pockterm زوج مفاتيح Ed25519 ويحفظ المفتاح الخاص في سلسلة مفاتيح iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm crea un par de claves Ed25519 y guarda la clave privada en el Llavero de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm crée une paire de clés Ed25519 et conserve la clé privée dans le trousseau iOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pockterm יוצר זוג מפתחות Ed25519 ושומר את המפתח הפרטי במחזיק המפתחות של iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm crea una coppia di chiavi Ed25519 e conserva la chiave privata nel Portachiavi iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm 会创建一个 Ed25519 密钥对，并将私钥存储在 iOS 钥匙串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm 會製作一組 Ed25519 金鑰組，並將私密金鑰儲存在 iOS 鑰匙圈中。"
          }
        }
      }
    },
    "Pockterm has no account, and your connection data stays on your device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستخدم Pockterm أي حساب، وتبقى بيانات اتصالك على جهازك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm no tiene cuentas, y los datos de tus conexiones permanecen en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm ne nécessite aucun compte, et les données de vos connexions restent sur votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-Pockterm אין חשבונות, ונתוני החיבורים שלך נשארים במכשיר שלך."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm non richiede alcun account e i dati delle tue connessioni restano sul tuo dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm 没有账户，你的连接数据都保留在设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm 沒有帳號，你的連線資料都保留在裝置上。"
          }
        }
      }
    },
    "Pockterm is a full-featured SSH client for iPhone. You can connect to servers, run an interactive terminal, transfer files over SFTP, and set up port-forwarding tunnels.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pockterm عميل SSH متكامل للآيفون. يمكنك الاتصال بالخوادم وتشغيل طرفية تفاعلية ونقل الملفات عبر SFTP وإعداد أنفاق لتوجيه المنافذ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm es un cliente SSH completo para iPhone. Puedes conectarte a servidores, usar un terminal interactivo, transferir archivos por SFTP y crear túneles de redirección de puertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm est un client SSH complet pour iPhone. Vous pouvez vous connecter à des serveurs, utiliser un terminal interactif, transférer des fichiers via SFTP et créer des tunnels de redirection de ports."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pockterm הוא לקוח SSH מלא לאייפון. אפשר להתחבר לשרתים, להריץ מסוף אינטראקטיבי, להעביר קבצים דרך SFTP ולהקים מנהרות לניתוב יציאות."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm è un client SSH completo per iPhone. Puoi connetterti a server, usare un terminale interattivo, trasferire file via SFTP e creare tunnel di inoltro porte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm 是一款功能完整的 iPhone SSH 客户端。你可以连接服务器、运行交互式终端、通过 SFTP 传输文件，并设置端口转发隧道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm 是一款功能完整的 iPhone SSH 用戶端。你可以連線伺服器、執行互動式終端機、透過 SFTP 傳輸檔案，並設定埠轉送通道。"
          }
        }
      }
    },
    "Pockterm reads the `Host`, `HostName`, `User`, and `Port` settings. Password credentials are created for each username so you can fill in the secret afterward.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Pockterm إعدادات `Host` و`HostName` و`User` و`Port`. وتُنشأ بيانات اعتماد بكلمة سر لكل اسم مستخدم لتتمكن من إدخال السر لاحقًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm lee los ajustes `Host`, `HostName`, `User` y `Port`. Se crean credenciales de contraseña para cada nombre de usuario, de modo que puedas rellenar el secreto después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm lit les réglages `Host`, `HostName`, `User` et `Port`. Des identifiants par mot de passe sont créés pour chaque nom d'utilisateur, afin que vous puissiez renseigner le secret par la suite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pockterm קורא את ההגדרות `Host`, `HostName`, `User` ו-`Port`. נוצרים אישורי גישה מסוג סיסמה לכל שם משתמש, כך שתוכל למלא את הסוד אחר כך."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm legge le impostazioni `Host`, `HostName`, `User` e `Port`. Per ogni nome utente vengono create credenziali con password, così puoi inserire il segreto in un secondo momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm 会读取 `Host`、`HostName`、`User` 和 `Port` 设置。系统会为每个用户名创建密码凭证，你可以随后填入密钥内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pockterm 會讀取 `Host`、`HostName`、`User` 與 `Port` 設定。系統會為每個使用者名稱製作密碼憑證，你可以稍後再填入密鑰內容。"
          }
        }
      }
    },
    "Port": {
      "localizations": {
        "ar": {
          "stringUnit": {
