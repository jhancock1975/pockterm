          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערכת נושא"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
