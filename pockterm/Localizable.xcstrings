    "Drag to reorder; swipe to remove. The bar scrolls horizontally in the terminal.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لإعادة الترتيب؛ ومرّر للإزالة. ينزلق الشريط أفقيًا داخل الطرفية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar; desliza para quitar. La barra se desplaza horizontalmente en el terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser ; balayez pour retirer. Dans le terminal, la barre défile horizontalement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור לשינוי הסדר; החלק להסרה. הסרגל נגלל לרוחב במסוף."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare; scorri per rimuovere. Nel terminale la barra scorre orizzontalmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可重新排序，滑动可移除。该栏在终端中横向滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移可重新排序，滑動可移除。此列在終端機中會水平捲動。"
          }
        }
      }
    },
    "Dynamic (SOCKS)": {
      "localizations": {
