    "Controls whether the assistant asks before running commands or editing files on your server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّد ما إذا كان المساعد يسأل قبل تنفيذ الأوامر أو تعديل الملفات على خادمك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla si el asistente pregunta antes de ejecutar comandos o editar archivos en tu servidor."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובע אם העוזר שואל לפני הרצת פקודות או עריכת קבצים בשרת שלך."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制助手在服务器上运行命令或编辑文件之前是否先询问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制助理在你的伺服器上執行指令或編輯檔案前是否先詢問。"
          }
        }
      }
    },
