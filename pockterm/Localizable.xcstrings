    "Required — Pockterm needs a username and either a password or a key to sign in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب — يحتاج Pockterm إلى اسم مستخدم وإلى كلمة سر أو مفتاح لتسجيل الدخول."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτείται — το Pockterm χρειάζεται όνομα χρήστη και είτε κωδικό είτε κλειδί για να συνδεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatorio: Pockterm necesita un nombre de usuario y una contraseña o una clave para iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatoire — Pockterm a besoin d'un nom d'utilisateur et d'un mot de passe ou d'une clé pour s'authentifier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש — Pockterm זקוק לשם משתמש ולסיסמה או מפתח כדי להתחבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवश्यक — साइन इन के लिए Pockterm को उपयोगकर्ता नाम और पासवर्ड या कुंजी चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obbligatorio — a Pockterm servono un nome utente e una password o una chiave per autenticarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必須です。サインインには、ユーザ名とパスワードまたは鍵が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필수입니다. 로그인하려면 사용자 이름과 암호 또는 키가 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обязательно — для входа Pockterm нужны имя пользователя и пароль или ключ."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అవసరం — సైన్ ఇన్ చేయడానికి Pockterm కు వినియోగదారు పేరు, మరియు పాస్‌వర్డ్ లేదా కీ కావాలి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обов'язково — для входу Pockterm потрібні ім'я користувача та пароль або ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必填 — Pockterm 需要用户名，以及密码或密钥才能登录。"
