    "Required — Pockterm needs a username and either a password or a key to sign in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب — يحتاج Pockterm إلى اسم مستخدم وإلى كلمة سر أو مفتاح لتسجيل الدخول."
          }
        },
        "es": {
