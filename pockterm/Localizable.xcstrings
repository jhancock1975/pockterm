            "value": "點一下 + 以產生 Ed25519 金鑰。"
          }
        }
      }
    },
    "Tap + to organize hosts into groups.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط + لتنظيم المضيفين في مجموعات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para organizar los hosts en grupos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש + כדי לארגן מארחים בקבוצות."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 + 将主机整理到群组中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 + 以將主機整理到群組中。"
          }
        }
      }
    },
    "Tap + to save a reusable command.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط + لحفظ أمر قابل لإعادة الاستخدام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para guardar un comando reutilizable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש + כדי לשמור פקודה לשימוש חוזר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 + 保存可重复使用的命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 + 以儲存可重複使用的指令。"
          }
        }
      }
    },
    "Tap a host to open a terminal session.": {},
    "Tap the **snippet** button to run a saved command in the session.": {},
