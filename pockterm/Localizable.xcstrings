{
  "sourceLanguage": "en",
  "strings": {
    "%@ API Key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح API لـ %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave API de %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח API של %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API 密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API 金鑰"
          }
        }
      }
    },
    "%@: %@": {
