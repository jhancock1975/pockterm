    "Review the detected hosts, turn off any you don't want, then tap **Import**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع المضيفين المكتشفين، وعطّل ما لا تريده، ثم اضغط **استيراد**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los hosts detectados, desactiva los que no quieras y toca **Importar**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les hôtes détectés, désactivez ceux dont vous ne voulez pas, puis touchez **Importer**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עבור על המארחים שזוהו, בטל את אלה שאינך רוצה, ואז הקש **ייבוא**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla gli host rilevati, disattiva quelli che non vuoi, poi tocca **Importa**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查检测到的主机，关闭不需要的，然后轻点**导入**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視偵測到的主機，關閉不需要的，然後點一下**輸入**。"
          }
        }
      }
    },
