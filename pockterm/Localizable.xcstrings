    "Accept only if the fingerprint matches what you expect from the server's owner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توافق إلا إذا كانت البصمة مطابقة لما تتوقعه من مالك الخادم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acéptala solo si la huella coincide con la que esperas del propietario del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'acceptez que si l'empreinte correspond à celle attendue de la part du propriétaire du serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר רק אם טביעת האצבע תואמת למה שאתה מצפה לו מבעל השרת."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta solo se il fingerprint corrisponde a quello che ti aspetti dal proprietario del server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在指纹与服务器所有者告知的一致时才接受。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在指紋與伺服器擁有者告知的相符時才接受。"
          }
        }
      }
    },
