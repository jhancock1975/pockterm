    "Once accepted, the key is remembered and you won't be asked again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد القبول، يُحفظ المفتاح ولن تُسأل مرة أخرى."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόλις γίνει αποδεκτό, το κλειδί απομνημονεύεται και δεν θα ερωτηθείτε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez aceptada, la clave se recuerda y no se te volverá a preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois acceptée, la clé est mémorisée et la question ne vous sera plus posée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר האישור, המפתח נשמר ולא תישאל שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार स्वीकार करने पर कुंजी याद रख ली जाती है और आपसे दोबारा नहीं पूछा जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta accettata, la chiave viene memorizzata e non ti verrà più chiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度受け入れると鍵が記憶され、次回以降は確認されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 수락하면 키가 기억되어 다시 묻지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После принятия ключ запоминается, и вопрос больше не появится."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకసారి అంగీకరించిన తర్వాత కీ గుర్తుంచుకోబడుతుంది, మిమ్మల్ని మళ్లీ అడగరు."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після прийняття ключ запам'ятовується, і вас більше не питатимуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦接受，该密钥就会被记住，不会再次询问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦接受，該金鑰就會被記住，不會再次詢問你。"
          }
        }
      }
    },
