    "Stored in the Keychain alongside the key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ في سلسلة المفاتيح إلى جانب المفتاح."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύεται στο Μπρελόκ μαζί με το κλειδί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en el Llavero junto a la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservée dans le trousseau avec la clé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמרת במחזיק המפתחות לצד המפתח."
          }
