    "The bar above the keyboard has **esc**, **ctrl**, **tab**, arrow keys, and more.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الشريط فوق لوحة المفاتيح على **esc** و**ctrl** و**tab** ومفاتيح الأسهم وغيرها."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μπάρα πάνω από το πληκτρολόγιο έχει **esc**, **ctrl**, **tab**, πλήκτρα βέλους και άλλα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra encima del teclado incluye **esc**, **ctrl**, **tab**, las teclas de flecha y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre au-dessus du clavier comporte **esc**, **ctrl**, **tab**, les touches fléchées et plus encore."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרגל מעל המקלדת כולל **esc**, **ctrl**, **tab**, מקשי חיצים ועוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीबोर्ड के ऊपर की पट्टी में **esc**, **ctrl**, **tab**, तीर कुंजियाँ और भी बहुत कुछ है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra sopra la tastiera contiene **esc**, **ctrl**, **tab**, i tasti freccia e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの上のバーには、**esc**、**ctrl**、**tab**、矢印キーなどがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 위의 막대에는 **esc**, **ctrl**, **tab**, 화살표 키 등이 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На панели над клавиатурой есть **esc**, **ctrl**, **tab**, клавиши со стрелками и другое."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కీబోర్డ్ పైన ఉన్న బార్‌లో **esc**, **ctrl**, **tab**, బాణం కీలు మరియు మరిన్ని ఉన్నాయి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На панелі над клавіатурою є **esc**, **ctrl**, **tab**, клавіші зі стрілками та інше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘上方的栏中包含 **esc**、**ctrl**、**tab**、方向键等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤上方的列中包含 **esc**、**ctrl**、**tab**、方向鍵等。"
          }
        }
      }
    },
    "The connection to the server was lost.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال بالخادم."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση με τον διακομιστή χάθηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión con el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au serveur a été perdue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור לשרת נותק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर से कनेक्शन टूट गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione al server si è interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバとの接続が切れました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버와의 연결이 끊어졌습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение с сервером потеряно."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సర్వర్‌తో కనెక్షన్ తెగిపోయింది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З'єднання із сервером втрачено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与服务器的连接已断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與伺服器的連線已中斷。"
          }
        }
      }
    },
    "The default for all hosts. \"Off\" keeps the current behavior. Individual hosts and groups can override this.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعداد الافتراضي لكل المضيفين. «إيقاف» يبقي السلوك الحالي. ويمكن للمضيفين والمجموعات فرادى تجاوزه."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προεπιλογή για όλους τους διακομιστές. Το «Ανενεργό» διατηρεί την τρέχουσα συμπεριφορά. Μεμονωμένοι διακομιστές και ομάδες μπορούν να την παρακάμψουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor predeterminado para todos los hosts. «Desactivado» mantiene el comportamiento actual. Los hosts y grupos individuales pueden anularlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur par défaut pour tous les hôtes. « Désactivé » conserve le comportement actuel. Les hôtes et les groupes peuvent la remplacer individuellement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברירת המחדל לכל המארחים. ״כבוי״ משאיר את ההתנהגות הנוכחית. מארחים וקבוצות בודדים יכולים לעקוף זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी होस्ट के लिए डिफ़ॉल्ट। «बंद» मौजूदा व्यवहार बनाए रखता है। अलग-अलग होस्ट और समूह इसे बदल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore predefinito per tutti gli host. \"Off\" mantiene il comportamento attuale. I singoli host e gruppi possono sovrascriverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのホストのデフォルトです。「オフ」にすると現在の動作のままになります。個々のホストやグループで上書きできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 호스트의 기본값입니다. \"끔\"으로 두면 현재 동작이 유지됩니다. 개별 호스트와 그룹에서 재정의할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение по умолчанию для всех хостов. «Выкл.» сохраняет текущее поведение. Отдельные хосты и группы могут переопределить его."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని హోస్ట్‌లకు డిఫాల్ట్. «ఆఫ్» ప్రస్తుత ప్రవర్తనను అలాగే ఉంచుతుంది. వ్యక్తిగత హోస్ట్‌లు, గ్రూప్‌లు దీన్ని మార్చవచ్చు."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типове значення для всіх хостів. «Вимк.» зберігає поточну поведінку. Окремі хости та групи можуть перевизначити його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有主机的默认设置。“关闭”会保持当前行为。单个主机和群组可以覆盖此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有主機的預設值。「關閉」會保持目前的行為。個別主機和群組可以覆寫此設定。"
          }
        }
      }
    },
    "The first time you connect to a server, Pockterm shows its key **fingerprint** and asks you to accept it. This is called trust on first use.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في أول مرة تتصل فيها بخادم، يعرض Pockterm **بصمة** مفتاحه ويطلب منك قبولها. ويسمى ذلك الثقة عند الاستخدام الأول."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Την πρώτη φορά που συνδέεστε σε έναν διακομιστή, το Pockterm εμφανίζει το **αποτύπωμα** του κλειδιού του και σας ζητά να το αποδεχτείτε. Αυτό ονομάζεται εμπιστοσύνη στην πρώτη χρήση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera vez que te conectas a un servidor, Pockterm muestra la **huella** de su clave y te pide que la aceptes. Esto se llama confianza en el primer uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première fois que vous vous connectez à un serveur, Pockterm affiche l'**empreinte** de sa clé et vous demande de l'accepter. C'est ce qu'on appelle la confiance à la première utilisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בפעם הראשונה שאתה מתחבר לשרת, ‏Pockterm מציג את **טביעת האצבע** של המפתח שלו ומבקש ממך לאשר אותה. זה נקרא אמון בשימוש ראשון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप किसी सर्वर से पहली बार कनेक्ट करते हैं, तो Pockterm उसकी कुंजी का **फ़िंगरप्रिंट** दिखाता है और उसे स्वीकारने को कहता है। इसे trust on first use कहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima volta che ti connetti a un server, Pockterm mostra il **fingerprint** della sua chiave e ti chiede di accettarlo. Questo si chiama trust on first use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに初めて接続するとき、Pockterm はその鍵の**フィンガープリント**を表示し、受け入れるかどうかを尋ねます。これは trust on first use と呼ばれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 처음 연결할 때 Pockterm은 해당 키의 **지문**을 표시하고 수락할지 묻습니다. 이를 최초 사용 시 신뢰(trust on first use)라고 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При первом подключении к серверу Pockterm показывает **отпечаток** его ключа и просит вас принять его. Это называется доверием при первом использовании."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఒక సర్వర్‌కు మొదటిసారి కనెక్ట్ అయినప్పుడు, Pockterm దాని కీ **వేలిముద్ర**ను చూపి, దాన్ని అంగీకరించమని అడుగుతుంది. దీన్ని trust on first use అంటారు."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час першого підключення до сервера Pockterm показує **відбиток** його ключа й просить вас прийняти його. Це називається довірою під час першого використання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次连接服务器时，Pockterm 会显示其密钥**指纹**并请你接受。这称为首次使用即信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次連線伺服器時，Pockterm 會顯示其金鑰**指紋**並請你接受。這稱為首次使用即信任。"
          }
        }
      }
    },
    "The key could not be read. It may be incomplete or corrupted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة المفتاح. قد يكون ناقصًا أو تالفًا."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί δεν ήταν δυνατό να διαβαστεί. Μπορεί να είναι ελλιπές ή κατεστραμμένο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la clave. Puede estar incompleta o dañada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé n’a pas pu être lue. Elle est peut-être incomplète ou endommagée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את המפתח. ייתכן שהוא חלקי או פגום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी नहीं पढ़ी जा सकी। यह अधूरी या क्षतिग्रस्त हो सकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la chiave. Potrebbe essere incompleta o danneggiata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵を読み取れませんでした。内容が不完全か破損している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 읽을 수 없습니다. 내용이 불완전하거나 손상되었을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать ключ. Возможно, он неполный или повреждён."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కీని చదవలేకపోయాం. అది అసంపూర్ణంగా లేదా పాడైనదిగా ఉండవచ్చు."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати ключ. Можливо, він неповний або пошкоджений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该密钥，文件可能不完整或已损坏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取該金鑰，檔案可能不完整或已損毀。"
          }
        }
      }
    },
    "The provider is overloaded. Try again shortly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزوّد محمّل بأكثر من طاقته. أعد المحاولة بعد قليل."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πάροχος είναι υπερφορτωμένος. Δοκιμάστε ξανά σύντομα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor está sobrecargado. Vuelve a intentarlo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur est surchargé. Réessayez dans un instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספק עמוס. נסה שוב בקרוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रदाता पर बहुत भार है। थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il provider è sovraccarico. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダが混み合っています。しばらくしてからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공업체가 과부하 상태입니다. 잠시 후 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер перегружен. Повторите попытку позже."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రొవైడర్‌పై భారం ఎక్కువగా ఉంది. కాసేపటి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер перевантажений. Спробуйте ще раз незабаром."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商负载过高。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商負載過高。請稍後再試。"
          }
        }
      }
    },
    "The remote shell ended.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت الصدفة البعيدة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το απομακρυσμένο κέλυφος τερματίστηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El shell remoto ha terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le shell distant s'est terminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המעטפת המרוחקת הסתיימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट शेल समाप्त हो गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La shell remota è terminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートシェルが終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 셸이 종료되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённая оболочка завершилась."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమోట్ షెల్ ముగిసింది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віддалену оболонку завершено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程 shell 已结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端 shell 已結束。"
          }
        }
      }
    },
    "The server refused the request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الخادم الطلب."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής απέρριψε το αίτημα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé la demande."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת דחה את הבקשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने अनुरोध अस्वीकार कर दिया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha rifiutato la richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバがリクエストを拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청을 거부했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер отклонил запрос."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సర్వర్ అభ్యర్థనను తిరస్కరించింది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер відхилив запит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器拒絕了要求。"
          }
        }
      }
    },
    "The terminal output%@ will be sent to %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُرسل مخرج الطرفية%@ إلى %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έξοδος του τερματικού%@ θα σταλεί στο %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida del terminal%@ se enviará a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie du terminal%@ sera envoyée à %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פלט המסוף%@ יישלח אל %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनल का आउटपुट%@ %@ को भेजा जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'output del terminale%@ sarà inviato a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルの出力%@ が %@ に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 출력%@이(가) %@에 전송됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вывод терминала%@ будет отправлен в %@."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టెర్మినల్ అవుట్‌పుట్%@ %@ కు పంపబడుతుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивід термінала%@ буде надіслано до %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端输出%@将发送给 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機輸出%@將傳送給 %@。"
          }
        }
      }
    },
    "Theme": {
