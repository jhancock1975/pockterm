    "%lldpt": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‎%lld نقطة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‎%lld נק׳"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 磅"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 點"
          }
        }
      }
    },
    "**Credentials** are a username plus a way to authenticate — either a password or an SSH key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**بيانات الاعتماد** هي اسم مستخدم بالإضافة إلى طريقة للمصادقة — إمّا كلمة سر أو مفتاح SSH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las **Credenciales** son un nombre de usuario más una forma de autenticarse: una contraseña o una clave SSH."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**אישורי גישה** הם שם משתמש בתוספת דרך אימות — סיסמה או מפתח SSH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**凭证**由用户名加上一种身份验证方式组成 — 密码或 SSH 密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**憑證**由使用者名稱加上一種驗證方式組成 — 密碼或 SSH 金鑰。"
          }
        }
      }
    },
    "**Dynamic** — a SOCKS5 proxy on your device sends each connection through the server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**ديناميكي** — وكيل SOCKS5 على جهازك يرسل كل اتصال عبر الخادم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dinámico**: un proxy SOCKS5 en tu dispositivo envía cada conexión a través del servidor."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**דינמי** — פרוקסי SOCKS5 במכשיר שלך שולח כל חיבור דרך השרת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**动态** — 设备上的 SOCKS5 代理会把每个连接都经由服务器发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**動態** — 裝置上的 SOCKS5 代理會將每個連線都經由伺服器傳送。"
          }
        }
      }
    },
    "**Local** — a port on your device forwards to a host the server can reach.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**محلي** — منفذ على جهازك يُوجَّه إلى مضيف يستطيع الخادم الوصول إليه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Local**: un puerto de tu dispositivo se redirige a un host al que el servidor puede llegar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**מקומי** — יציאה במכשיר שלך מנותבת אל מארח שהשרת יכול להגיע אליו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**本地** — 设备上的某个端口转发到服务器能访问的主机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**本機** — 裝置上的某個埠轉送到伺服器能連到的主機。"
          }
        }
      }
    },
    "**Long-press a host** and choose **Browse Files**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**اضغط مطوّلًا على مضيف** واختر **تصفح الملفات**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mantén pulsado un host** y elige **Explorar archivos**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**לחץ לחיצה ארוכה על מארח** ובחר **עיין בקבצים**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**长按主机**并选择**浏览文件**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**長按主機**並選擇**瀏覽檔案**。"
          }
        }
      }
    },
    "**Long-press the file**, then choose **Download**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**اضغط مطوّلًا على الملف**، ثم اختر **تنزيل**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mantén pulsado el archivo** y luego elige **Descargar**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**לחץ לחיצה ארוכה על הקובץ** ואז בחר **הורד**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**长按文件**，然后选择**下载**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**長按檔案**，然後選擇**下載**。"
          }
        }
      }
    },
    "**Long-press** a file to Rename it, change its **Permissions**, or Delete it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**اضغط مطوّلًا** على ملف لإعادة تسميته أو تغيير **الأذونات** الخاصة به أو حذفه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mantén pulsado** un archivo para renombrarlo, cambiar sus **Permisos** o eliminarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**לחץ לחיצה ארוכה** על קובץ כדי לשנות את שמו, לשנות את **ההרשאות** שלו או למחוק אותו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**长按**文件可重命名、更改其**权限**或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**長按**檔案可重新命名、更改其**權限**或刪除。"
          }
        }
      }
    },
    "**Remote** — a port on the server forwards back to your device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**بعيد** — منفذ على الخادم يُوجَّه رجوعًا إلى جهازك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Remoto**: un puerto del servidor se redirige de vuelta a tu dispositivo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**מרוחק** — יציאה בשרת מנותבת בחזרה אל המכשיר שלך."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**远程** — 服务器上的某个端口转发回你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**遠端** — 伺服器上的某個埠轉送回你的裝置。"
          }
        }
      }
    },
    "**Star** a host (swipe left) to pin it to a Favorites section.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**ميّز بنجمة** مضيفًا (مرّر لليسار) لتثبيته في قسم المفضّلة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Destaca** un host (desliza a la izquierda) para fijarlo en la sección Favoritos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**סמן בכוכב** מארח (החלק שמאלה) כדי לקבע אותו למקטע המועדפים."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为主机**标记星标**（向左滑动）可将其固定到“收藏”分组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為主機**標上星號**（向左滑動）可將其釘選到「收藏」區段。"
          }
        }
      }
    },
    "**Swipe left** for Edit, Star, or Delete.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**مرّر لليسار** للتحرير أو التمييز بنجمة أو الحذف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desliza a la izquierda** para Editar, Destacar o Eliminar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**החלק שמאלה** לעריכה, סימון בכוכב או מחיקה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**向左滑动**可进行编辑、标记星标或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**向左滑動**可編輯、標上星號或刪除。"
          }
        }
      }
    },
    "**Swipe right** and tap **Files** to browse it over SFTP.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**مرّر لليمين** واضغط **الملفات** لتصفحه عبر SFTP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desliza a la derecha** y toca **Archivos** para explorarlo por SFTP."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**החלק ימינה** והקש **קבצים** כדי לעיין בו דרך SFTP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**向右滑动**并轻点**文件**，即可通过 SFTP 浏览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**向右滑動**並點一下**檔案**，即可透過 SFTP 瀏覽。"
          }
        }
      }
    },
    "**Tap a row** to edit it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**اضغط على صف** لتحريره."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toca una fila** para editarla."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**הקש על שורה** כדי לערוך אותה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**轻点某一行**即可编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**點一下某一列**即可編輯。"
          }
        }
      }
    },
    "**Tap** a host to connect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**اضغط** على مضيف للاتصال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toca** un host para conectarte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**הקש** על מארח כדי להתחבר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**轻点**主机即可连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**點一下**主機即可連線。"
          }
        }
      }
    },
    "..": {
      "shouldTranslate": false
    },
