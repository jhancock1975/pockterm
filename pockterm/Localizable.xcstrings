    "Keys are stored in the iOS Keychain and sent only to %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ المفاتيح في سلسلة مفاتيح iOS ولا تُرسل إلا إلى %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλειδιά αποθηκεύονται στο Μπρελόκ του iOS και αποστέλλονται μόνο στο %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves se guardan en el Llavero de iOS y solo se envían a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés sont conservées dans le trousseau iOS et envoyées uniquement à %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתחות נשמרים במחזיק המפתחות של iOS ונשלחים רק אל %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजियाँ iOS कीचेन में रखी जाती हैं और केवल %@ को भेजी जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi sono conservate nel Portachiavi iOS e inviate solo a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵は iOS のキーチェーンに保存され、%@ にのみ送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 iOS 키체인에 저장되며 %@에만 전송됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи хранятся в связке ключей iOS и отправляются только в %@."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కీలు iOS కీచెయిన్‌లో నిల్వ చేయబడతాయి మరియు %@ కు మాత్రమే పంపబడతాయి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключі зберігаються у зв'язці ключів iOS і надсилаються лише до %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥存储在 iOS 钥匙串中，且仅发送给 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰儲存在 iOS 鑰匙圈中，且只會傳送給 %@。"
          }
        }
      }
    },
