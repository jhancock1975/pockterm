    "Disconnect the display and the terminal comes back to the phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افصل الشاشة فتعود الطرفية إلى الهاتف."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποσυνδέστε την οθόνη και το τερματικό επιστρέφει στο τηλέφωνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecta la pantalla y el terminal vuelve al teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débranchez l'écran et le terminal revient sur le téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתק את המסך והמסוף חוזר לטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्प्ले हटाते ही टर्मिनल वापस फ़ोन पर आ जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollega lo schermo e il terminale torna sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイを外すと、ターミナルは iPhone に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 연결을 끊으면 터미널이 iPhone으로 돌아옵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите экран — и терминал вернётся на телефон."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డిస్‌ప్లేను డిస్‌కనెక్ట్ చేస్తే టెర్మినల్ తిరిగి ఫోన్‌కు వస్తుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від'єднайте екран — і термінал повернеться на телефон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开显示器后，终端会回到手机上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷顯示器連線後，終端機會回到手機上。"
          }
        }
      }
    },
