    "Accept Changed Key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبول المفتاح المتغيّر"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar clave modificada"
          }
        },
