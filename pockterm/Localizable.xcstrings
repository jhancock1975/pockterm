            "state": "translated",
            "value": "ポート転送"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트 포워딩"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенаправление портов"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోర్ట్ ఫార్వర్డింగ్"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переспрямування портів"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口转发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "埠轉送"
          }
        }
      }
    },
    "Port forwarding routes network connections through an SSH server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجّه توجيهُ المنافذ اتصالاتِ الشبكة عبر خادم SSH."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προώθηση θυρών δρομολογεί συνδέσεις δικτύου μέσω ενός διακομιστή SSH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La redirección de puertos encamina conexiones de red a través de un servidor SSH."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La redirection de ports achemine les connexions réseau via un serveur SSH."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתוב יציאות מנתב חיבורי רשת דרך שרת SSH."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोर्ट फ़ॉरवर्डिंग नेटवर्क कनेक्शन को SSH सर्वर के ज़रिए भेजती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inoltro delle porte instrada le connessioni di rete attraverso un server SSH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート転送は、ネットワーク接続を SSH サーバ経由で中継します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트 포워딩은 네트워크 연결을 SSH 서버를 통해 전달합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенаправление портов направляет сетевые соединения через сервер SSH."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోర్ట్ ఫార్వర్డింగ్ నెట్‌వర్క్ కనెక్షన్‌లను SSH సర్వర్ ద్వారా పంపుతుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переспрямування портів скеровує мережеві з'єднання через сервер SSH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口转发会将网络连接经由 SSH 服务器进行路由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "埠轉送會將網路連線經由 SSH 伺服器進行路由。"
          }
        }
      }
    },
