    "Port Forwarding": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجيه المنافذ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirección de puertos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirection de ports"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתוב יציאות"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inoltro porte"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口转发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "埠轉送"
          }
        }
      }
    },
    "Port forwarding routes network connections through an SSH server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجّه توجيهُ المنافذ اتصالاتِ الشبكة عبر خادم SSH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La redirección de puertos encamina conexiones de red a través de un servidor SSH."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La redirection de ports achemine les connexions réseau via un serveur SSH."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתוב יציאות מנתב חיבורי רשת דרך שרת SSH."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inoltro delle porte instrada le connessioni di rete attraverso un server SSH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口转发会将网络连接经由 SSH 服务器进行路由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "埠轉送會將網路連線經由 SSH 伺服器進行路由。"
          }
        }
      }
    },
    "Protocol": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البروتوكول"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocolo"
          }
        },
        "fr": {
