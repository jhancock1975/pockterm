    "Required — Pockterm needs a username and either a password or a key to sign in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب — يحتاج Pockterm إلى اسم مستخدم وإلى كلمة سر أو مفتاح لتسجيل الدخول."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatorio: Pockterm necesita un nombre de usuario y una contraseña o una clave para iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatoire — Pockterm a besoin d'un nom d'utilisateur et d'un mot de passe ou d'une clé pour s'authentifier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש — Pockterm זקוק לשם משתמש ולסיסמה או מפתח כדי להתחבר."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obbligatorio — a Pockterm servono un nome utente e una password o una chiave per autenticarsi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必填 — Pockterm 需要用户名，以及密码或密钥才能登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必填 — Pockterm 需要使用者名稱，以及密碼或金鑰才能登入。"
          }
        }
      }
    },
