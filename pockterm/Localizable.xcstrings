      }
    },
    "Tap + to organize hosts into groups.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط + لتنظيم المضيفين في مجموعات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para organizar los hosts en grupos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש + כדי לארגן מארחים בקבוצות."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 + 将主机整理到群组中。"
          }
