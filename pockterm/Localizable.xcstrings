    "Controls whether the assistant asks before running commands or editing files on your server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّد ما إذا كان المساعد يسأل قبل تنفيذ الأوامر أو تعديل الملفات على خادمك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθορίζει αν ο βοηθός ρωτά πριν εκτελέσει εντολές ή επεξεργαστεί αρχεία στον διακομιστή σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla si el asistente pregunta antes de ejecutar comandos o editar archivos en tu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détermine si l'assistant demande confirmation avant d'exécuter des commandes ou de modifier des fichiers sur votre serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובע אם העוזר שואל לפני הרצת פקודות או עריכת קבצים בשרת שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तय करता है कि सहायक आपके सर्वर पर कमांड चलाने या फ़ाइलें बदलने से पहले पूछे या नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Determina se l'assistente chiede conferma prima di eseguire comandi o modificare file sul tuo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントがサーバ上でコマンドを実行したりファイルを編集したりする前に確認するかどうかを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 서버에서 명령어를 실행하거나 파일을 편집하기 전에 확인할지 여부를 결정합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, спрашивает ли ассистент перед выполнением команд или изменением файлов на вашем сервере."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సర్వర్‌లో కమాండ్‌లను అమలు చేసే ముందు లేదా ఫైల్‌లను మార్చే ముందు సహాయకుడు అడగాలా వద్దా అనేది నిర్ణయిస్తుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначає, чи запитує асистент перед виконанням команд або зміною файлів на вашому сервері."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制助手在服务器上运行命令或编辑文件之前是否先询问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制助理在你的伺服器上執行指令或編輯檔案前是否先詢問。"
          }
        }
      }
    },
