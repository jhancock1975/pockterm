    "For **Key**, select one of your keys.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالنسبة إلى **المفتاح**، اختر أحد مفاتيحك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για **Κλειδί**, επιλέξτε ένα από τα κλειδιά σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para **Clave**, selecciona una de tus claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour **Clé**, sélectionnez l'une de vos clés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עבור **מפתח**, בחר אחד מהמפתחות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**कुंजी** के लिए, अपनी कुंजियों में से एक चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per **Chiave**, seleziona una delle tue chiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**鍵**を選んだ場合は、登録済みの鍵から 1 つ選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**키**를 선택한 경우, 보유한 키 중 하나를 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для варианта **Ключ** выберите один из своих ключей."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "**కీ** కోసం, మీ కీలలో ఒకదాన్ని ఎంచుకోండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для варіанта **Ключ** виберіть один зі своїх ключів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于**密钥**，请选择你的密钥之一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於**金鑰**，請選擇你的其中一把金鑰。"
          }
        }
      }
    },
