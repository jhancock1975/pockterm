{
  "sourceLanguage": "en",
  "strings": {
    "%@ API Key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح API لـ %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave API de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé API %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח API של %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave API %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API 密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API 金鑰"
          }
        }
      }
    },
    "%@: %@": {
