    "In a host's editor, choose **New Credentials**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في محرّر المضيف، اختر **بيانات اعتماد جديدة**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στον επεξεργαστή ενός διακομιστή, επιλέξτε **Νέα διαπιστευτήρια**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el editor de un host, elige **Credenciales nuevas**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l'éditeur d'un hôte, choisissez **Nouveaux identifiants**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בעורך של מארח, בחר **אישורי גישה חדשים**."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी होस्ट के संपादक में **नए क्रेडेंशियल** चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell'editor di un host, scegli **Nuove credenziali**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストのエディタで、**新規認証情報**を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 편집기에서 **새로운 인증 정보**를 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В редакторе хоста выберите **Новые учётные данные**."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక హోస్ట్ ఎడిటర్‌లో **కొత్త ఆధారాలు** ఎంచుకోండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У редакторі хоста виберіть **Нові облікові дані**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主机的编辑器中，选择**新建凭证**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在主機的編輯器中，選擇**新增憑證**。"
          }
        }
      }
    },
