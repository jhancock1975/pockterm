    "Give a host a **Startup Snippet** to run it automatically on connect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح المضيف **مقتطف بدء** لتشغيله تلقائيًا عند الاتصال."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώστε σε έναν διακομιστή ένα **Απόσπασμα εκκίνησης** για να εκτελείται αυτόματα κατά τη σύνδεση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna a un host un **Fragmento de inicio** para ejecutarlo automáticamente al conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez à un hôte un **Extrait de démarrage** pour l'exécuter automatiquement à la connexion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדר למארח **קטע הפעלה** כדי להריץ אותו אוטומטית בעת החיבור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी होस्ट को **स्टार्टअप स्निपेट** दें ताकि कनेक्ट होते ही वह अपने आप चले।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna a un host uno **Snippet di avvio** per eseguirlo automaticamente alla connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストに**起動スニペット**を設定すると、接続時に自動的に実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에 **시작 스니펫**을 지정하면 연결할 때 자동으로 실행됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначьте хосту **Стартовый сниппет**, чтобы он выполнялся автоматически при подключении."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కనెక్ట్ అయినప్పుడు స్వయంచాలకంగా అమలయ్యేలా ఒక హోస్ట్‌కు **ప్రారంభ స్నిప్పెట్** ఇవ్వండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призначте хосту **Стартовий сніпет**, щоб він виконувався автоматично під час підключення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为主机设置**启动代码片段**，即可在连接时自动运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為主機設定**啟動程式碼片段**，即可在連線時自動執行。"
          }
        }
      }
    },
