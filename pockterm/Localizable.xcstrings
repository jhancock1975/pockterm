    "Use the tabs along the bottom to move between **Hosts**, **Snippets**, **Keychain**, and **Port Forwarding**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم علامات التبويب في الأسفل للتنقل بين **المضيفون** و**المقتطفات** و**سلسلة المفاتيح** و**توجيه المنافذ**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las pestañas de la parte inferior para moverte entre **Hosts**, **Fragmentos**, **Llavero** y **Redirección de puertos**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les onglets en bas pour passer de **Hôtes** à **Extraits**, **Trousseau** et **Redirection de ports**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בלשוניות שבתחתית כדי לעבור בין **מארחים**, **קטעים**, **מחזיק מפתחות** ו**ניתוב יציאות**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le schede in basso per spostarti tra **Host**, **Snippet**, **Portachiavi** e **Inoltro porte**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用底部的标签在**主机**、**代码片段**、**钥匙串**和**端口转发**之间切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用底部的標籤在**主機**、**程式碼片段**、**鑰匙圈**與**埠轉送**之間切換。"
          }
        }
      }
    },
