    "Review the detected hosts, turn off any you don't want, then tap **Import**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع المضيفين المكتشفين، وعطّل ما لا تريده، ثم اضغط **استيراد**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τους διακομιστές που εντοπίστηκαν, απενεργοποιήστε όσους δεν θέλετε και μετά πατήστε **Εισαγωγή**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los hosts detectados, desactiva los que no quieras y toca **Importar**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les hôtes détectés, désactivez ceux dont vous ne voulez pas, puis touchez **Importer**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עבור על המארחים שזוהו, בטל את אלה שאינך רוצה, ואז הקש **ייבוא**."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिले हुए होस्ट देखें, जो नहीं चाहिए उन्हें बंद करें, फिर **आयात करें** टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla gli host rilevati, disattiva quelli che non vuoi, poi tocca **Importa**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出されたホストを確認し、不要なものをオフにしてから、**読み込む**をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지된 호스트를 검토하고 원하지 않는 항목을 끈 다음 **가져오기**를 탭하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите найденные хосты, отключите ненужные и нажмите **Импорт**."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గుర్తించిన హోస్ట్‌లను సమీక్షించి, మీకు వద్దనుకున్నవాటిని ఆఫ్ చేసి, ఆ తర్వాత **దిగుమతి చేయి** నొక్కండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте виявлені хости, вимкніть непотрібні, потім торкніться **Імпорт**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查检测到的主机，关闭不需要的，然后轻点**导入**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視偵測到的主機，關閉不需要的，然後點一下**輸入**。"
          }
        }
      }
    },
