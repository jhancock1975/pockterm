    "Passwords and private keys are kept in the **iOS Keychain**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ كلمات السر والمفاتيح الخاصة في **سلسلة مفاتيح iOS**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κωδικοί και τα ιδιωτικά κλειδιά φυλάσσονται στο **Μπρελόκ του iOS**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas y las claves privadas se guardan en el **Llavero de iOS**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de passe et les clés privées sont conservés dans le **trousseau iOS**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיסמאות ומפתחות פרטיים נשמרים ב**מחזיק המפתחות של iOS**."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड और निजी कुंजियाँ **iOS कीचेन** में रखी जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le password e le chiavi private sono conservate nel **Portachiavi iOS**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードと秘密鍵は **iOS のキーチェーン**に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호와 개인 키는 **iOS 키체인**에 보관됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароли и закрытые ключи хранятся в **связке ключей iOS**."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాస్‌వర్డ్‌లు మరియు ప్రైవేట్ కీలు **iOS కీచెయిన్**లో ఉంచబడతాయి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролі та закриті ключі зберігаються у **зв'язці ключів iOS**."
          }
        },
        "zh-Hans": {
