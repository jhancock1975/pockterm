          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కాన్ఫిగ్ టెక్స్ట్‌ను అతికించండి, లేదా **ఫైల్ ఎంచుకోండి** నొక్కండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте текст своєї конфігурації або торкніться **Вибрати файл**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴你的配置文本，或轻点**选择文件**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上你的設定文字，或點一下**選擇檔案**。"
          }
        }
      }
    },
