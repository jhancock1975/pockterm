    "While connected, tap the snippet button in the terminal to run one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الاتصال، اضغط زر المقتطف في الطرفية لتشغيل أحدها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras estés conectado, toca el botón de fragmento en el terminal para ejecutar uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois connecté, touchez le bouton extrait dans le terminal pour en exécuter un."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בזמן שאתה מחובר, הקש על כפתור הקטע במסוף כדי להריץ אחד."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre sei connesso, tocca il pulsante snippet nel terminale per eseguirne uno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接期间，轻点终端中的代码片段按钮即可运行一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線期間，點一下終端機中的程式碼片段按鈕即可執行一個。"
          }
        }
      }
    },
