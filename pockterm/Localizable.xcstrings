          }
        }
      }
    },
    "This session was closed after being idle. You can change how long sessions stay connected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلقت هذه الجلسة بعد فترة خمول. يمكنك تغيير مدة بقاء الجلسات متصلة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión se cerró tras estar inactiva. Puedes cambiar cuánto tiempo permanecen conectadas las sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session a été fermée après une période d'inactivité. Vous pouvez modifier la durée pendant laquelle les sessions restent connectées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההפעלה נסגרה לאחר חוסר פעילות. אפשר לשנות כמה זמן הפעלות נשארות מחוברות."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa sessione è stata chiusa dopo un periodo di inattività. Puoi modificare per quanto tempo le sessioni restano connesse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话在闲置后已关闭。你可以更改会话保持连接的时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作階段在閒置後已關閉。你可以更改工作階段保持連線的時間長度。"
          }
        }
      }
    },
    "Transferring Files (SFTP)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
