    },
    "The assistant wants to run:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يريد المساعد تنفيذ:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente quiere ejecutar:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'assistant veut exécuter :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העוזר מבקש להריץ:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'assistente vuole eseguire:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手想要运行："
          }
        },
        "zh-Hant": {
