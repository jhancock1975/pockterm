        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "埠轉送"
          }
        }
      }
    },
    "Port forwarding routes network connections through an SSH server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجّه توجيهُ المنافذ اتصالاتِ الشبكة عبر خادم SSH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La redirección de puertos encamina conexiones de red a través de un servidor SSH."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתוב יציאות מנתב חיבורי רשת דרך שרת SSH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口转发会将网络连接经由 SSH 服务器进行路由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "埠轉送會將網路連線經由 SSH 伺服器進行路由。"
          }
        }
      }
    },
