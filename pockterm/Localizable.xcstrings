          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 API 密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 API 金鑰"
          }
        }
      }
    },
    "Paste your config text, or tap **Choose File**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق نص الإعداد الخاص بك، أو اضغط **اختيار ملف**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el texto de tu configuración o toca **Elegir archivo**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק את טקסט התצורה שלך, או הקש **בחר קובץ**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴你的配置文本，或轻点**选择文件**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上你的設定文字，或點一下**選擇檔案**。"
          }
        }
      }
    },
    "Paste ~/.ssh/config": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لصق ‎~/.ssh/config"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar ~/.ssh/config"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק ‎~/.ssh/config"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 ~/.ssh/config"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 ~/.ssh/config"
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأذونات"
          }
        },
        "es": {
