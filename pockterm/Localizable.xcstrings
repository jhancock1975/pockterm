          "stringUnit": {
            "state": "translated",
            "value": "點一下 + 以儲存可重複使用的指令。"
          }
        }
      }
    },
    "Tap a host to open a terminal session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على مضيف لفتح جلسة طرفية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un host para abrir una sesión de terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un hôte pour ouvrir une session de terminal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על מארח כדי לפתוח הפעלת מסוף."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un host per aprire una sessione di terminale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点主机即可打开终端会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下主機即可打開終端機工作階段。"
          }
        }
      }
    },
    "Tap the **snippet** button to run a saved command in the session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط زر **المقتطف** لتشغيل أمر محفوظ داخل الجلسة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de **fragmento** para ejecutar un comando guardado en la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton **extrait** pour exécuter une commande enregistrée dans la session."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על כפתור ה**קטע** כדי להריץ פקודה שמורה בהפעלה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante **snippet** per eseguire un comando salvato nella sessione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点**代码片段**按钮，即可在会话中运行已保存的命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下**程式碼片段**按鈕，即可在工作階段中執行已儲存的指令。"
          }
        }
      }
    },
