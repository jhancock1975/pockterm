    "On the **Hosts** tab, tap **+**, then **New Host**.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من علامة التبويب **المضيفون**، اضغط **+** ثم **مضيف جديد**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pestaña **Hosts**, toca **+** y luego **Host nuevo**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l'onglet **Hôtes**, touchez **+**, puis **Nouvel hôte**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלשונית **מארחים**, הקש **+** ואז **מארח חדש**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella scheda **Host**, tocca **+**, poi **Nuovo host**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在**主机**标签页中，轻点 **+**，然后选择**新建主机**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在**主機**標籤頁中，點一下 **+**，然後選擇**新增主機**。"
          }
        }
      }
    },
    "On the **Keychain** tab, tap **+** and give the key a label.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من علامة التبويب **سلسلة المفاتيح**، اضغط **+** وأعطِ المفتاح تسمية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pestaña **Llavero**, toca **+** y ponle una etiqueta a la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l'onglet **Trousseau**, touchez **+** et donnez un libellé à la clé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלשונית **מחזיק מפתחות**, הקש **+** ותן למפתח תווית."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella scheda **Portachiavi**, tocca **+** e assegna un'etichetta alla chiave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在**钥匙串**标签页中，轻点 **+** 并为密钥设置标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在**鑰匙圈**標籤頁中，點一下 **+** 並為金鑰設定標籤。"
          }
        }
      }
    },
    "On the **Port Forwarding** tab, tap **+** to add one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من علامة التبويب **توجيه المنافذ**، اضغط **+** لإضافة واحد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pestaña **Redirección de puertos**, toca **+** para añadir una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l'onglet **Redirection de ports**, touchez **+** pour en ajouter une."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלשונית **ניתוב יציאות**, הקש **+** כדי להוסיף אחד."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella scheda **Inoltro porte**, tocca **+** per aggiungerne uno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在**端口转发**标签页中，轻点 **+** 添加一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在**埠轉送**標籤頁中，點一下 **+** 加入一個。"
          }
        }
      }
    },
    "On the **Snippets** tab, tap **+** to save a command with a label.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من علامة التبويب **المقتطفات**، اضغط **+** لحفظ أمر مع تسمية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pestaña **Fragmentos**, toca **+** para guardar un comando con una etiqueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l'onglet **Extraits**, touchez **+** pour enregistrer une commande avec un libellé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלשונית **קטעים**, הקש **+** כדי לשמור פקודה עם תווית."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella scheda **Snippet**, tocca **+** per salvare un comando con un'etichetta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在**代码片段**标签页中，轻点 **+** 保存带标签的命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在**程式碼片段**標籤頁中，點一下 **+** 儲存帶標籤的指令。"
          }
        }
      }
    },
    "On the Key Bar": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في شريط المفاتيح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la barra de teclas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la barre de touches"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בסרגל המקשים"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla barra tasti"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在按键栏中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在按鍵列中"
          }
        }
      }
    },
    "Once accepted, the key is remembered and you won't be asked again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد القبول، يُحفظ المفتاح ولن تُسأل مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez aceptada, la clave se recuerda y no se te volverá a preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois acceptée, la clé est mémorisée et la question ne vous sera plus posée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר האישור, המפתח נשמר ולא תישאל שוב."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta accettata, la chiave viene memorizzata e non ti verrà più chiesto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦接受，该密钥就会被记住，不会再次询问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦接受，該金鑰就會被記住，不會再次詢問你。"
          }
        }
      }
    },
    "Open Terminal": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح الطرفية"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir el terminal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le terminal"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח מסוף"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il terminale"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开终端"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開終端機"
          }
        }
      }
    },
    "Open several hosts at once — each session is a tab across the top. Tap its name to switch, or the red **✕** to close it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح عدة مضيفين في وقت واحد — كل جلسة هي علامة تبويب في الأعلى. اضغط على اسمها للتبديل، أو على **✕** الحمراء لإغلاقها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre varios hosts a la vez: cada sesión es una pestaña en la parte superior. Toca su nombre para cambiar, o la **✕** roja para cerrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez plusieurs hôtes à la fois — chaque session est un onglet en haut. Touchez son nom pour changer de session, ou la **✕** rouge pour la fermer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לפתוח כמה מארחים בו-זמנית — כל הפעלה היא לשונית בחלק העליון. הקש על השם כדי להחליף, או על ה-**✕** האדום כדי לסגור."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri più host contemporaneamente — ogni sessione è una scheda in alto. Tocca il suo nome per passare a essa, o la **✕** rossa per chiuderla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可同时打开多台主机 — 每个会话都是顶部的一个标签。轻点名称可切换，轻点红色 **✕** 可关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可同時打開多部主機 — 每個工作階段都是頂端的一個標籤。點一下名稱可切換，點一下紅色 **✕** 可關閉。"
          }
        }
      }
    },
    "Open the browser": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح المتصفّح"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir el explorador"
          }
        },
        "fr": {
