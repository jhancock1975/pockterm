    "Already in a session? Tap the **folder** button in the terminal's top bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت داخل جلسة بالفعل؟ اضغط زر **المجلد** في الشريط العلوي للطرفية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya estás en una sesión? Toca el botón de **carpeta** en la barra superior del terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà dans une session ? Touchez le bouton **dossier** dans la barre supérieure du terminal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר בתוך הפעלה? הקש על כפתור **התיקייה** בסרגל העליון של המסוף."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei già in una sessione? Tocca il pulsante **cartella** nella barra superiore del terminale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经在会话中了？轻点终端顶部栏中的**文件夹**按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經在工作階段中了嗎？點一下終端機頂端列中的**檔案夾**按鈕。"
          }
        }
      }
    },
