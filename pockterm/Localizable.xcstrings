    "Add a host on the Hosts tab first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مضيفًا من علامة التبويب «المضيفون» أولًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade un host en la pestaña Hosts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord un hôte dans l'onglet Hôtes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תחילה הוסף מארח בלשונית המארחים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima un host nella scheda Host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“主机”标签页中添加主机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在「主機」標籤頁中加入主機。"
          }
        }
      }
    },
    "Add the shown public-key line to the server's `~/.ssh/authorized_keys` file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف سطر المفتاح العام المعروض إلى ملف `~/.ssh/authorized_keys` على الخادم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la línea de clave pública que se muestra al archivo `~/.ssh/authorized_keys` del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez la ligne de clé publique affichée au fichier `~/.ssh/authorized_keys` du serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף את שורת המפתח הציבורי המוצגת לקובץ `~/.ssh/authorized_keys` בשרת."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la riga di chiave pubblica mostrata al file `~/.ssh/authorized_keys` del server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把显示的公钥这一行添加到服务器的 `~/.ssh/authorized_keys` 文件中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將顯示的公開金鑰那一行加入伺服器的 `~/.ssh/authorized_keys` 檔案。"
          }
        }
      }
    },
