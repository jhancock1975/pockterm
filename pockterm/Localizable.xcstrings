    },
    "Tap + to save a reusable command.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط + لحفظ أمر قابل لإعادة الاستخدام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para guardar un comando reutilizable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש + כדי לשמור פקודה לשימוש חוזר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 + 保存可重复使用的命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 + 以儲存可重複使用的指令。"
          }
        }
      }
    },
    "Tap a host to open a terminal session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على مضيف لفتح جلسة طرفية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un host para abrir una sesión de terminal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על מארח כדי לפתוח הפעלת מסוף."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点主机即可打开终端会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下主機即可打開終端機工作階段。"
          }
        }
      }
    },
    "Tap the **snippet** button to run a saved command in the session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط زر **المقتطف** لتشغيل أمر محفوظ داخل الجلسة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de **fragmento** para ejecutar un comando guardado en la sesión."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על כפתור ה**קטע** כדי להריץ פקודה שמורה בהפעלה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点**代码片段**按钮，即可在会话中运行已保存的命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下**程式碼片段**按鈕，即可在工作階段中執行已儲存的指令。"
          }
        }
      }
    },
    "Terminal": {
      "shouldTranslate": false
    },
    "Terminal Theme": {
