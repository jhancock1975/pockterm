            "state": "translated",
            "value": "%@ API 金鑰"
          }
        }
      }
    },
    "%@ keys aren't supported yet. Ed25519 and RSA keys can be imported.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفاتيح %@ غير مدعومة بعد. يمكن استيراد مفاتيح Ed25519 وRSA."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλειδιά %@ δεν υποστηρίζονται ακόμη. Μπορείτε να εισαγάγετε κλειδιά Ed25519 και RSA."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves %@ aún no son compatibles. Se pueden importar claves Ed25519 y RSA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés %@ ne sont pas encore prises en charge. Vous pouvez importer des clés Ed25519 et RSA."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתחות %@ אינם נתמכים עדיין. אפשר לייבא מפתחות Ed25519 ו‑RSA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ कुंजियाँ अभी समर्थित नहीं हैं। Ed25519 और RSA कुंजियाँ आयात की जा सकती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi %@ non sono ancora supportate. Puoi importare chiavi Ed25519 e RSA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 鍵にはまだ対応していません。読み込めるのは Ed25519 鍵と RSA 鍵です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 키는 아직 지원하지 않습니다. Ed25519와 RSA 키를 가져올 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи %@ пока не поддерживаются. Можно импортировать ключи Ed25519 и RSA."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కీలకు ఇంకా మద్దతు లేదు. Ed25519 మరియు RSA కీలను దిగుమతి చేయవచ్చు."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключі %@ поки не підтримуються. Можна імпортувати ключі Ed25519 та RSA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持 %@ 密钥。可导入 Ed25519 和 RSA 密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫不支援 %@ 金鑰。可輸入 Ed25519 與 RSA 金鑰。"
          }
        }
      }
    },
