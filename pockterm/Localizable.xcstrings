        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी के साथ कीचेन में सहेजा जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvata nel Portachiavi insieme alla chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵とともにキーチェーンに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키와 함께 키체인에 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется в «Ключах» вместе с ключом."
          }
