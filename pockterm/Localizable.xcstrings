    },
    "Accept only if the fingerprint matches what you expect from the server's owner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توافق إلا إذا كانت البصمة مطابقة لما تتوقعه من مالك الخادم."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποδεχτείτε μόνο αν το αποτύπωμα ταιριάζει με αυτό που περιμένετε από τον κάτοχο του διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acéptala solo si la huella coincide con la que esperas del propietario del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'acceptez que si l'empreinte correspond à celle attendue de la part du propriétaire du serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר רק אם טביעת האצבע תואמת למה שאתה מצפה לו מבעל השרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल तभी स्वीकारें जब फ़िंगरप्रिंट वही हो जिसकी आप सर्वर के मालिक से अपेक्षा करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta solo se il fingerprint corrisponde a quello che ti aspetti dal proprietario del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィンガープリントがサーバの管理者から知らされたものと一致する場合にのみ受け入れてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지문이 서버 소유자로부터 확인한 값과 일치하는 경우에만 수락하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принимайте, только если отпечаток совпадает с тем, который вы ожидаете от владельца сервера."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సర్వర్ యజమాని నుండి మీరు ఆశించిన దానితో వేలిముద్ర సరిపోలితే మాత్రమే అంగీకరించండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приймайте, лише якщо відбиток збігається з тим, який ви очікуєте від власника сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在指纹与服务器所有者告知的一致时才接受。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在指紋與伺服器擁有者告知的相符時才接受。"
          }
        }
      }
    },
