    "**Credentials** are a username plus a way to authenticate — either a password or an SSH key.": {},
    "**Dynamic** — a SOCKS5 proxy on your device sends each connection through the server.": {},
    "**Local** — a port on your device forwards to a host the server can reach.": {},
    "**Long-press a host** and choose **Browse Files**.": {},
    "**Long-press the file**, then choose **Download**.": {},
    "**Long-press** a file to Rename it, change its **Permissions**, or Delete it.": {},
    "**Remote** — a port on the server forwards back to your device.": {},
    "**Star** a host (swipe left) to pin it to a Favorites section.": {},
    "**Swipe left** for Edit, Star, or Delete.": {},
    "**Swipe right** and tap **Files** to browse it over SFTP.": {},
    "**Tap a row** to edit it.": {},
    "**Tap** a host to connect.": {},
    "..": {
      "shouldTranslate": false
    },
    "A SOCKS5 proxy listens on the bind port; each connection is tunneled to its requested destination.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع وكيل SOCKS5 على منفذ الربط؛ ويُنفَّق كل اتصال إلى الوجهة المطلوبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proxy SOCKS5 escucha en el puerto de enlace; cada conexión se tuneliza hacia el destino solicitado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרוקסי SOCKS5 מאזין ביציאת הקישור; כל חיבור מנותב אל היעד שביקש."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SOCKS5 代理在绑定端口上监听；每个连接都会被隧道转发到它请求的目标地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SOCKS5 代理會在綁定埠上監聽；每個連線都會透過通道轉送到它要求的目的地。"
          }
        }
      }
    },
